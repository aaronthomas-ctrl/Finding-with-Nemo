{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && node scripts/guard-industry-terms.mjs",
    "db:apply": "node --env-file=.env scripts/apply-schema.mjs",
    "smoke:llm": "tsx scripts/smoke-llm.ts",
    "eval:injection": "tsx scripts/injection-eval.ts",
    "test:patterns": "tsx scripts/test-patterns.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "3d-force-graph": "^1.80.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.44.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "three": "^0.186.1",
    "umap-js": "^1.4.0",
    "uuid": "^14.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.65.1",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/google.maps": "^3.65.3",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
