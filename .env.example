# Copy to .env and fill in. Never commit .env.

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=""
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"
MODEL_ULTRA="nvidia/Nemotron-3-Ultra-550b-a55b"
MODEL_SUPER="nvidia/Nemotron-3.5-Super-VL"
MODEL_NANO="nvidia/Nemotron-3_5-Lightning"
MODEL_EMBED="Qwen/Qwen3-Embedding-8B"
EMBED_DIMENSIONS=1024
# Optional: Nemotron safety + ASR live on NVIDIA NIM (build.nvidia.com) when not on Token Factory.
NVIDIA_NIM_API_KEY=""
MODEL_SAFETY=""
MODEL_ASR=""
# OpenAI-compatible speech-to-text (NVIDIA NIM). Leave empty to use the browser transcript instead.
ASR_BASE_URL=""
ASR_API_KEY=""

# --- Supabase ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-PUBLISHABLE-KEY"
# Used only by scripts/ and Nebius Jobs. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# --- Other services ---
TAVILY_API_KEY=""
GOOGLE_MAPS_PLATFORM_KEY=""

# --- Encryption for phone, email and transcripts (32 random bytes, base64) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=""

APP_URL="http://localhost:3000"

# Hard cap on AI requests per signed-in user (free judge access). 0 = unlimited.
AI_CALLS_PER_USER=40

# Optional second Google key for the server only: restrict it by API (Places, Geocoding, Directions), not by website.
GOOGLE_MAPS_SERVER_KEY=""
